# Modele de configuration. A copier en `.env`, qui lui N'EST PAS VERSIONNE.
#
#   cp .env.exemple .env
#
# `.env` doit figurer dans `.gitignore`. Un mot de passe pousse sur un depot distant est
# considere comme compromis, meme si le commit est retire ensuite : il reste dans
# l'historique, dans les clones et dans les caches de la forge.

ANNUAIRE_BASE_URL=postgresql+psycopg://annuaire:motdepasse_local@localhost:5432/annuaire
ANNUAIRE_SOURCE=donnees/brut
ANNUAIRE_LOT=2000
ANNUAIRE_JOURNAL_NIVEAU=INFO
ANNUAIRE_JOURNAL_JSON=false
